# Moss — repository hygiene
# This repository tracks Moss source, content and docs. Published binaries
# live in GitHub Releases, never in git. The rules below also cover
# regenerated publish metadata that ships beside a local portable copy.

# .NET build outputs (if compilable source is added later)
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
artifacts/

# Visual Studio / IDE state
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet packages / lock artifacts that should never be committed directly
*.nupkg
*.snupkg

# Regenerated .NET publish metadata (recreated by every publish)
Moss.deps.json
Moss.runtimeconfig.json

# Local Moss runtime state (user data lives in %LOCALAPPDATA%\Moss,
# never in this repository)
moss.jsonl*
*.bak
*.corrupt-*
notebook/

# Logs, crash dumps, temp files
*.log
*.dmp
*.tmp
*.temp
[Cc]rash[Dd]umps/

# OS metadata
Thumbs.db
desktop.ini
.DS_Store

# Secrets / signing material (never commit)
*.pfx
*.p12
*.pem
*.key
*.cer
.env

# Moss — repository hygiene
# This baseline tracks the Moss 1.3.0 portable distribution as-is.
# The rules below guard against future junk; they intentionally do NOT
# exclude any file already committed in the baseline.

# .NET build outputs (if compilable source is added later)
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
artifacts/

# Visual Studio / IDE state
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet packages / lock artifacts that should never be committed directly
*.nupkg
*.snupkg

# Local Moss runtime state (user data lives in %LOCALAPPDATA%\Moss,
# never in this repository)
moss.jsonl*
*.bak
*.corrupt-*
notebook/

# Logs, crash dumps, temp files
*.log
*.dmp
*.tmp
*.temp
[Cc]rash[Dd]umps/

# OS metadata
Thumbs.db
desktop.ini
.DS_Store

# Secrets / signing material (never commit)
*.pfx
*.p12
*.pem
*.key
*.cer
.env

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reconstruction-era regression harness: a small set of deterministic
       checks over Moss.Core (content validation, scalar audio hysteresis,
       command grammar, version stamp). Console app; nonzero exit on failure.
       The original 95-case harness was not shipped and is not recoverable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moss.Core\Moss.Core.csproj" />
  </ItemGroup>
</Project>
